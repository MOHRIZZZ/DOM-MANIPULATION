//we put class so dot .
//first one by defualt
let itm = document.querySelector('.list-group-item');
itm.style.color = 'red';

//pseduo slectors are : this cna be of posstion,user  or form 

//end child 
//.class : last-child
let lastitm = document.querySelector('.list-group-item:last-child');
lastitm.style.color = 'blue';

//nth child 
//.class : nth-child()
let nthitm = document.querySelector('.list-group-item:nth-child(2)');
nthitm.style.color = 'pink';


// query selectorall // anything you can put
//grabs more than one 

