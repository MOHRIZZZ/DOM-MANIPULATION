 //Advacned events 

 let box = document.getElementById('box');

 //now so enter so gives in console
 box.addEventListener('mouseenter',rnevent);
//mouse leave will be when i get out of elemnt 
box.addEventListener('mouseleave',rnevent);


//now for inner element mouseover & mouseout
box.addEventListener('mouseover',rnevent);
box.addEventListener('mouseout',rnevent);


//mousemove when i am in it 
box.addEventListener('mousemove',rnevent);

function rnevent(e){
  console.log('Eventtype :'+ e.type);

//from mousemove we can grab position 
//and do stuff with it 
  output.innerHTML ='<h3>MouseX:'+e.offsetX +'</h3>'+'<h3>MouseY:'+e.offsetY +'</h3>' 
 

//now we gonna use this same offset adn change color
 box.style.backgroundColor = "rgb("+e.offsetX+","+e.offsetY+",30)";
//and can also change body color
 document.body.style.backgroundColor = "rgb("+e.offsetX+","+e.offsetY+",30)"; 
}

